# Copy to .env.local and fill in. Never commit .env.local.

# LLM gateway (OpenAI-compatible). Oxion by default; River works by swapping these three.
LLM_API_KEY=
LLM_BASE_URL=https://oxionai.com/v1
LLM_MODEL=

# Optional automatic fallback (e.g. River), used when the primary is down, out of credit, or times out.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# Supabase (slice 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (slice 3)
RESEND_API_KEY=
EMAIL_FROM=ApplyReady <onboarding@resend.dev>

# Daily cron (slice 4)
CRON_SECRET=

APP_URL=http://localhost:3000
