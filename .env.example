# Copy to .env.local and fill in. Never commit .env.local.

# LLM gateway (OpenAI-compatible). Oxion by default; River works by swapping these three.
LLM_API_KEY=
LLM_BASE_URL=https://oxionai.com/v1
LLM_MODEL=

# Optional automatic fallback (e.g. River), used when the primary is down, out of credit, or times out.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# Supabase (slice 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email: your own mailbox over SMTP (recommended, delivers to anyone). For Gmail: turn on 2-Step
# Verification, create an App Password at https://myaccount.google.com/apppasswords, then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
#   EMAIL_FROM=ApplyReady <you@gmail.com>
# If SMTP_HOST is empty, Resend is used instead (only delivers to your own address without a domain).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Resend (fallback)
RESEND_API_KEY=
EMAIL_FROM=ApplyReady <onboarding@resend.dev>

# Daily cron (slice 4)
CRON_SECRET=

APP_URL=http://localhost:3000
